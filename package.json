{
    "name": "cb-hostsbox",
    "id": "com.github.rexlevin.cb-hostsbox",
    "private": true,
    "version": "1.1.3",
    "description": "HostsBox - 跨平台的 hosts 文件管理工具",
    "author": "rexlevin",
    "license": "Apache-2.0",
    "homepage": "https://github.com/rexlevin/cb-hostsbox",
    "main": "main.js",
    "logo": "public/logo.png",
    "keywords": [
        "hosts",
        "network",
        "development",
        "utility"
    ],
    "scripts": {
        "dev": "vite --port 5175",
        "build": "vite build",
        "preview": "vite preview",
        "dist": "electron-builder --linux dir",
        "start": "cross-env NODE_ENV=development electron -r ../canbox-core/injection.js . --app-id=cb-hostsbox --no-sandbox"
    },
    "dependencies": {
        "@codemirror/language-data": "^6.5.2",
        "@codemirror/state": "^6.5.4",
        "@codemirror/theme-one-dark": "^6.1.3",
        "@codemirror/view": "^6.39.11",
        "@element-plus/icons-vue": "^2.3.2",
        "codemirror": "^6.0.2",
        "element-plus": "^2.13.1",
        "vue": "^3.5.17",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.0",
        "cross-env": "^10.1.0",
        "electron": "42.5.1",
        "electron-builder": "^26.0.12",
        "typescript": "^5.9.3",
        "vite": "^7.0.0"
    },
    "build": {
        "appId": "com.github.rexlevin.cb-hostsbox",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "preload.js",
            "build/**/*",
            "public/**/*",
            "package.json"
        ],
        "linux": {
            "target": [
                "dir"
            ]
        }
    }
}
